# ============================================================================
# DISJOYA AUTOPARTES S.A.S. - VARIABLES DE ENTORNO
# Compatible con Supabase (Free Tier) y Vercel / Render / Local
# ============================================================================

# 1. BASE DE DATOS (Supabase PostgreSQL)
# Copia la URI de tu proyecto en Supabase (Project Settings -> Database -> Connection URI):
# Reemplaza [TU-PASSWORD] y [PROJECT-REF]
DJY_DATABASE_URL=postgresql+psycopg://postgres:[TU-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. SECRETOS CRIPTOGRÁFICOS
# Genera strings aleatorios seguros en PowerShell con:
# python -c "import secrets; print(secrets.token_hex(32))"
DJY_JWT_SECRET=generar_un_secreto_hex_de_al_menos_32_caracteres_aleatorios_123456
DJY_PEPPER_DISPOSITIVO=otro_secreto_hex_para_proteger_identificadores_de_celular_123456

# Llave de 32 bytes (256 bits) en Base64 para cifrado AES-256 de coordenadas GPS en reposo:
# Generar con: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
DJY_AES_KEY_B64=4q2+X8rY1Zp9Qv7Wx3Ku6Lt5Ps4Rw1Vz9Ty8Ui7Ok6M=

# 3. TIEMPO Y CONFIGURACIÓN LEGAL
DJY_ZONA_HORARIA=America/Bogota
DJY_NTP_HABILITADO=true
DJY_NTP_SERVIDOR=time.google.com
DJY_NTP_MODO_ESTRICTO=false
DJY_QR_TTL_SEGUNDOS=30
DJY_ENTORNO=produccion

